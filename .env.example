# ---------------------------------------------------------------------------
# hermes-voice
#
# Tudo funciona sem preencher nada aqui, exceto HERMES_URL. Nao ha chave de API
# para voz nem para palavra de ativacao: todas as engines rodam locais.
# ---------------------------------------------------------------------------

# --- Hermes (LLM) -- endpoint compativel com /v1/chat/completions em streaming
HERMES_URL=http://127.0.0.1:8080/v1/chat/completions
HERMES_MODEL=hermes
HERMES_API_KEY=
HERMES_TIMEOUT=60
HISTORY_TURNS=8

# --- Voz -----------------------------------------------------------------
# Escolha uma do catalogo: hermes-voice voices --languages
# 35 idiomas via Piper (indice publico) + 9 via Kokoro. Exemplos:
#   pt_BR-faber-medium   pt-BR, Piper,  MIT,        padrao
#   pm_alex              pt-BR, Kokoro, Apache-2.0
#   am_michael           en-US, Kokoro, Apache-2.0
#   em_alex              es,    Kokoro, Apache-2.0
#   zm_yunxi             zh,    Kokoro, Apache-2.0
#   pt_BR-faber-medium  Piper,  MIT,         padrao, leve
#   pt_BR-edresson-low  Piper,  MIT,         menor
#   pm_alex             Kokoro, Apache-2.0,  melhor prosodia
#   pm_santa            Kokoro, Apache-2.0,  mais grave
#   pf_dora             Kokoro, Apache-2.0,  feminina
VOICE=pt_BR-faber-medium
TTS_BACKEND=auto
KOKORO_SPEED=0.95
# Onde vozes e modelos ficam. Vazio = raiz do repo, ou ~/.hermes-voice
DATA_DIR=

# --- Presenca (DSP): faz a voz soar como som na sala, nao locucao --------
# off | room | close | hall | intercom     ("hall" exagera de proposito)
DSP_PRESET=room
DSP_REVERB_MIX=
DSP_PRESENCE_GAIN_DB=
DSP_COMP_RATIO=
DSP_OUTPUT_GAIN_DB=

# --- Palavra de ativacao -------------------------------------------------
# auto     modelo treinado do openWakeWord. Melhor deteccao, catalogo pequeno:
#          hey_jarvis, alexa, hey_mycroft, hey_rhasspy. Exige "ei jarvis".
# keyword  QUALQUER palavra, QUALQUER idioma, sem treinar. Menos preciso, e a
#          fala e transcrita ANTES da ativacao -- ver SECURITY.md.
# open     sem palavra: qualquer fala abre a sessao. Use fone.
# none     desliga.
WAKE_BACKEND=auto

# Modo auto:
WAKE_MODEL=hey_jarvis
WAKE_MODEL_PATH=
WAKE_THRESHOLD=0.5
WAKE_AUTO_DOWNLOAD=1

# Modo keyword: palavra livre. Separe apelidos por virgula -- e assim que se
# recupera o que o Whisper erra na SUA voz, sem afrouxar o limiar global.
WAKE_WORDS=jarvis,jarvez,gervis
WAKE_KEYWORD_MODEL=tiny
WAKE_KEYWORD_DEVICE=cpu
# -1 = automatico (0 edicao para palavra curta, 1 para o resto)
WAKE_TOLERANCE=-1

# --- Fluidez -------------------------------------------------------------
# Endpointing adaptativo: encerra rapido quando a frase parece completa e
# espera mais quando parece pendurada ("eu quero...").
ADAPTIVE_ENDPOINT=1
ENDPOINT_SHORT_MS=380
ENDPOINT_LONG_MS=1250
ENDPOINT_MAX_PROBES=2
# Limiar usado quando ADAPTIVE_ENDPOINT=0, e como caso intermediario quando =1
SILENCE_MS=700
MIN_SPEECH_MS=200
# Janela em que voce fala sem repetir a palavra de ativacao
FOLLOW_UP_SECONDS=20
MAX_UTTERANCE_SECONDS=30
# Numeros e siglas por extenso antes de sintetizar. Ganho grande de qualidade.
NORMALIZE_TEXT=1

# --- Duplex --------------------------------------------------------------
# 1 = nao escuta enquanto fala (robusto, sem eco).
# 0 = permite interromper por voz, usando supressao de eco. Fone e melhor.
HALF_DUPLEX=1
ECHO_MARGIN_DB=7
ECHO_TRIGGER_FRAMES=3

# --- STT (faster-whisper) ------------------------------------------------
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
WHISPER_LANGUAGE=pt
# Vocabulario de dominio: melhora MUITO nome proprio e sigla.
# NUNCA faca commit de termos internos -- cliente, produto, ferramenta.
# Este arquivo esta no .gitignore por esse motivo.
WHISPER_HINT=

# --- VAD -----------------------------------------------------------------
VAD_BACKEND=auto
VAD_MODEL=
VAD_THRESHOLD=0.5
VAD_ENERGY_THRESHOLD=0.02

# --- Audio ---------------------------------------------------------------
INPUT_DEVICE=
OUTPUT_DEVICE=

# --- Interacao -----------------------------------------------------------
PTT_KEY=f9
QUIT_KEY=esc
PERSONA_FILE=
# Grava em disco o que voce falar. Off por default.
LOG_TRANSCRIPTS=0
